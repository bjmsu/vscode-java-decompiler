<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.jdt.ls.core.contentProvider">
      <contentProvider id="procyon" class="com.benjamin.su.decompiler.ProcyonDecompiler" priority="999">
      </contentProvider>
   </extension>
   <extension point="org.eclipse.jdt.ls.core.delegateCommandHandler">
      <delegateCommandHandler class="com.benjamin.su.decompiler.JarCommandHandler">
         <command id="decompile.browseJar"/>
         <command id="decompile.decompileEntry"/>
         <command id="decompile.readEntry"/>
         <command id="decompile.browseNestedJar"/>
         <command id="decompile.decompileNestedEntry"/>
         <command id="decompile.readNestedEntry"/>
         <command id="decompile.getInnerClassLine"/>
         <command id="decompile.getNestedInnerClassLine"/>
      </delegateCommandHandler>
   </extension>
</plugin>
